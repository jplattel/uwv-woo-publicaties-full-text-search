    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        66.0,
        430.01,
        612.0,
        445.01
      ],
      "text": "Een document is in EA niet aan de juiste werkgever gekoppeld of is ten onrechte aan een werkgever gekoppeld.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        66.0,
        460.01,
        84.4,
        474.01
      ],
      "text": "Doel",

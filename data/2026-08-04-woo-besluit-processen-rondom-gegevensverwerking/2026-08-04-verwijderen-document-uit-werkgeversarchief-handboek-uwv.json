      "page": 1,
      "bbox": [
        66.0,
        531.01,
        151.0,
        546.01
      ],
      "text": "AM , MVB , UD , MU.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        66.0,
        561.01,
        108.67,
        575.01
      ],
      "text": "Gevolgen",
      "source": "text"
    },

      "page": 1,
      "bbox": [
        66.0,
        581.01,
        260.3,
        596.01
      ],
      "text": "Documenten uit het archief verwijderen.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        66.0,
        611.01,
        110.55,
        625.01
      ],

    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        66.0,
        480.01,
        593.0,
        495.01
      ],
      "text": "Een document dat in EA gekoppeld is aan een (verkeerde) werkgever verwijderen uit het werkgeversarchief.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        66.0,
        511.01,
        141.94,
        525.01
      ],
      "text": "Functionarissen",

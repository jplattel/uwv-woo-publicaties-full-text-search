    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        117.0,
        705.01,
        329.0,
        720.01
      ],
      "text": "Beoordeel welke situatie van toepassing is:",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        132.0,
        735.01,
        730.0,
        750.01
      ],
      "text": "Het document is gekoppeld aan de verkeerde werkgever en het document hoeft niet gekoppeld te worden aan een andere",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        119.0,
        740.02,
        122.0,
        756.02
      ],
      "text": "•",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        132.0,
        755.01,
        181.09,
        770.01
      ],
      "text": "werkgever.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        132.0,
        774.01,
        204.67,
        789.01
      ],
      "text": "Ga naar stap 2.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        132.0,
        794.01,
        689.09,
        809.01
      ],
      "text": "Het document is gekoppeld aan de verkeerde werkgever en moet nog gekoppeld worden aan de juiste werkgever.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        119.0,
        798.02,
        122.0,
        814.02
      ],
      "text": "•",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        132.0,
        813.01,
        204.67,
        828.01
      ],
      "text": "Ga naar stap 3.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        74.0,
        833.01,
        286.33,
        847.01
      ],
      "text": "2 Document laten verwijderen uit EA",
      "source": "text"
    },
    {
      "type": "heading",
      "page": 1,
      "bbox": [
        117.0,
        853.01,
        198.33,
        868.01
      ],
      "text": "AM , MVB , UD , MU",

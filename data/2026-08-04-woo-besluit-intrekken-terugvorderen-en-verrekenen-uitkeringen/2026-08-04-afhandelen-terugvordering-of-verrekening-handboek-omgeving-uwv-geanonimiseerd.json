      "type": "paragraph",
      "page": 1,
      "bbox": [
        74.0,
        756.01,
        754.55,
        771.01
      ],
      "text": "Je verstuurt het formulier per e-mail op basis van de postcodeverdeling van de afdeling VFV Invorderen naar de mailbox van het VFV-team",
      "source": "text"
    },

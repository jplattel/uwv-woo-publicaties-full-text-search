    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        73.0,
        460.01,
        362.93,
        474.01
      ],
      "text": "Datum Korte omschrijving",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        73.0,
        491.01,
        700.46,
        505.01
      ],
      "text": "12 januari 2026 De zoekfunctie van de handboekenwebsite is op vrijdagavond 9 januari 2026 verbeterd.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        272.0,
        511.01,
        579.46,
        525.01
      ],
      "text": "Het onderdeel Zoeken in handboeken is daarom ook gewijzigd.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        73.0,
        541.01,
        685.67,
        555.01
      ],
      "text": "22 augustus 2025 Op vrijdagavond 22 augustus is een nieuwe navigatiestructuur geïntroduceerd op de",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        272.0,
        561.01,
        710.0,
        575.01
      ],
      "text": "handboekenwebsite. Gebruikers krijgen met de nieuwe navigatiestructuur meer inzicht in",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        272.0,
        580.01,
        415.5,
        594.01
      ],
      "text": "de structuur van documenten.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        272.0,
        600.01,
        699.46,
        614.01
      ],
      "text": "Het onderdeel ‘Uitleg presentatie handboek’ is daarom bij Navigatiestructuur gewijzigd.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        73.0,
        631.01,
        696.0,
        645.01
      ],
      "text": "17 juli 2025 Het onderdeel Browsegegevens verwijderen voor betere presentatie werkinstructies in",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        272.0,
        650.01,
        706.0,
        664.01
      ],
      "text": "handboeken is nieuw. Daarin staan de stappen die je uitvoert om de presentatie van veel",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        272.0,
        670.01,
        414.34,
        684.01
      ],
      "text": "werkinstructies te verbeteren.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        73.0,
        700.01,
        685.0,
        714.01
      ],
      "text": "28 mei 2025 In het onderdeel ‘Probleemoplossingen bij gebruik handboekenwebsite’ is Spaties in",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        272.0,
        720.01,
        395.43,
        734.01
      ],
      "text": "gemarkeerde tekst nieuw.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        73.0,
        751.01,
        431.43,
        765.01
      ],
      "text": "20 februari 2025 Dit wijzigingenoverzicht is nieuw.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        272.0,
        770.01,
        609.0,
        784.01
      ],
      "text": "De Handleiding Handboekenwebsite UWV bevatte namelijk nog geen",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        272.0,
        790.01,
        697.0,
        804.01
      ],
      "text": "wijzigingenoverzicht. Je leest in dit wijzigingsoverzicht voortaan over de wijzigingen in",

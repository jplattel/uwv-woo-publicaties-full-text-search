      "bbox": [
        444.0,
        951.01,
        712.67,
        966.01
      ],
      "text": "’Beslissingsformulier van het Expertiseteam’ waarin de",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        444.0,
        970.01,
        584.86,
        985.01
      ],
      "text": "uiteindelijke beslissing staat.",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        74.0,
        990.01,
        95.66,
        1004.01
      ],
      "text": "Input",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        74.0,
        1010.01,
        99.71,
        1024.01
      ],
      "text": "Intern",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        444.0,
        1011.01,
        697.13,
        1026.01
      ],
      "text": "Situatie van herziening , intrekking en terugvordering",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        431.0,
        1015.02,
        434.0,
        1031.02
      ],
      "text": "•",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        444.0,
        1030.01,
        763.5,
        1045.01
      ],
      "text": "Verzoek van cliënt om terugvorderbesluit te herzien op grond van",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        431.0,
        1034.02,
        434.0,

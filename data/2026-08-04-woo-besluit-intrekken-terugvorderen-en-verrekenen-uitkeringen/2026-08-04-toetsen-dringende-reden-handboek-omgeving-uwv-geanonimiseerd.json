    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        444.0,
        931.01,
        708.0,
        946.01
      ],
      "text": "Je ontvangt van het Expertiseteam een e-mail met het",
      "source": "text"
    },
    {
      "type": "paragraph",
      "page": 1,
      "bbox": [
        431.0,
